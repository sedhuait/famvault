{
  "name": "famvault",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=26.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/react": "~19.3.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:ios": "npm run check && npm test && npx expo-doctor && npx expo export --platform ios --output-dir /tmp/famvault-ios-export",
    "check": "npm run lint && npm run typecheck"
  },
  "private": true
}
